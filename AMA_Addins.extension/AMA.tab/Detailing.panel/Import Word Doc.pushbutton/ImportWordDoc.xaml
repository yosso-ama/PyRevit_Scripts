<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Word Doc" Width="860" Height="620" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Word documents" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Add..." Width="80" Click="add_files"/>
                <Button Content="Remove" Width="80" Margin="6,0,0,0" Click="remove_file"/>
            </StackPanel>
            <ListBox x:Name="files_list" SelectionChanged="file_selected"/>
        </DockPanel>

        <DockPanel Grid.Row="0" Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" x:Name="pages_title" Text="Pages" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock DockPanel.Dock="Top" x:Name="pages_source" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button DockPanel.Dock="Left" Content="All" Width="50" Click="select_all"/>
                <Button DockPanel.Dock="Left" Content="None" Width="50" Margin="6,0,0,0" Click="select_none"/>
                <Button DockPanel.Dock="Right" Content="Apply" Width="60" Margin="6,0,0,0" Click="apply_range"/>
                <TextBlock DockPanel.Dock="Left" Text="Pages:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <TextBox x:Name="pages_text" VerticalContentAlignment="Center"
                         ToolTip="Pages to import, e.g. 2-4, 7. Click Apply to check them."/>
            </DockPanel>
            <ListBox x:Name="pages_list"/>
        </DockPanel>

        <GroupBox Grid.Row="1" Grid.ColumnSpan="3" Header="Text and layout" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="6">
                <TextBlock Text="Text type:" VerticalAlignment="Center"/>
                <ComboBox x:Name="text_type" Width="240" Margin="6,0,24,0"/>
                <TextBlock Text="Column width (in.):" VerticalAlignment="Center"/>
                <TextBox x:Name="col_width" Width="60" Margin="6,0,24,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="Column height (in.):" VerticalAlignment="Center"/>
                <TextBox x:Name="col_height" Width="60" Margin="6,0,0,0" VerticalContentAlignment="Center"
                         ToolTip="Text flows into a new column past this height on the sheet."/>
            </StackPanel>
        </GroupBox>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True" Click="cancel"/>
            <Button DockPanel.Dock="Right" Content="Import" Width="80" IsDefault="True" Click="do_import"/>
            <TextBlock x:Name="status" VerticalAlignment="Center" Foreground="Firebrick" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
